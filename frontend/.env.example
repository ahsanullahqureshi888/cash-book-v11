# Public Browser-exposed API Endpoint (Leave empty for same-origin relative URLs)
VITE_API_URL=

# Optional Neon Auth Base URL (Leave empty to use default local database auth)
VITE_NEON_AUTH_URL=

# Server configuration (Used by Vite Node process in development, not exposed to browser bundle)
DEV_PORT=5173
BACKEND_PORT=8000
BACKEND_URL=
